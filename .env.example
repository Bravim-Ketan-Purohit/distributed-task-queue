# DTQ Configuration — copy to .env and adjust as needed.
# All variables are prefixed with DTQ_ per pydantic-settings convention.

DTQ_REDIS_URL=redis://localhost:7202/0
DTQ_DATABASE_URL=postgresql+asyncpg://dtq:dtq_dev@localhost:7203/dtq
DTQ_KAFKA_BOOTSTRAP_SERVERS=localhost:7216
DTQ_RABBITMQ_URL=amqp://dtq:dtq_dev@localhost:7217/

DTQ_BROKER_BACKEND=redis
DTQ_WORKER_ID=worker-1
DTQ_WORKER_QUEUES=default
DTQ_WORKER_CONCURRENCY=8
DTQ_LEASE_MS=30000
DTQ_HEARTBEAT_INTERVAL_S=10.0

DTQ_CONTROL_HOST=0.0.0.0
DTQ_CONTROL_PORT=7201
DTQ_ENABLE_CHAOS=0

DTQ_GRPC_PORT=7219
DTQ_OTEL_ENABLED=0
DTQ_OTEL_ENDPOINT=http://localhost:7221
DTQ_METRICS_PORT=7206
